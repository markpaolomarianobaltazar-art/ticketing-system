<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<%- include('header') %>
<body>
    <div class="header">
        <div class="brand-section">
            <h2>
                <span class="brand-highlight">M&B</span> IT Solutions
            </h2>
        
            <p class="company-tagline">
                <%= dashboardTitle %> • Welcome, 
                <strong><%= user.name %></strong>
            </p>
        </div>
        <div class="header-actions">
            <a href="/admin" class="btn">Back</a>
            <a href="#" onclick="confirmLogout()" class="btn logout-btn">
                Logout
            </a>
        </div>
    </div>

<table class="table ">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Position</th>
            <th>Open Tickets</th>
            <th>Total Tickets</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% technicians.forEach(tech => { %>
            <tr>
                <td><%= tech.full_name %></td>
                <td><%= tech.email %></td>
                <td><%= tech.position %></td>
                <td><%= tech.open_tickets || 0 %></td>
                <td><%= tech.total_tickets || 0 %></td>
                <td>
                    <a href="/admin/technician/<%= tech.user_id %>/tickets" class="btn small-btn">View Tickets</a>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>
<%- include('footer') %>
</body>

<script>
    function confirmLogout() {
        showConfirm("Are you sure you want to logout?", function () {
            window.location.href = "/logout";
        });
    }
</script>