<!DOCTYPE html>
<html>
<head>
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<%- include('header') %>
<body>
<div class="container">
    <div class="header">
        <div class="brand-section">
            <h2>
                <span class="brand-highlight">M&B</span> IT Solutions
            </h2>
        
            <p class="company-tagline">
                <%= dashboardTitle %> • Welcome, 
                <strong><%= user.name %></strong>
            </p>
        </div>
        <div>
            <a href="#" onclick="confirmLogout()" class="btn logout-btn">Logout</a>
        </div>
    </div>
    <div class="card overview-card">

        <h3>System Overview</h3>
    
        <div class="overview-stats">
            <div class="stat-box">
                <span>Total Tickets</span>
                <h2><%= stats.totalTickets || 0 %></h2>
            </div>
            <div class="stat-box">
                <span>Open</span>
                <h2><%= stats.openTickets || 0 %></h2>
            </div>
            <div class="stat-box">
                <span>Closed</span>
                <h2><%= stats.closedTickets || 0 %></h2>
            </div>
            <div class="stat-box">
                <span>Technicians</span>
                <h2><%= users.technicians || 0 %></h2>
            </div>
            <div class="stat-box">
                <span>Customers</span>
                <h2><%= users.customers || 0 %></h2>
            </div>
        </div>
    
    </div>
    <div class="admin-grid">

        <div class="card">
            <h3>User Management</h3>
            <p>View, create, edit, and assign roles.</p>
            <a href="/admin/users" class="btn">Manage Users</a>
        </div>

        <div class="card">
            <h3>Ticket Control</h3>
            <p>Assign technicians, close/reopen tickets.</p>
            <a href="/tickets/all" class="btn">Manage Tickets</a>
        </div>

        <div class="card">
            <h3>Technician Management</h3>
            <p>Monitor and assign workload.</p>
            <a href="/admin/technicians" class="btn">View Technicians</a>
        </div>

        <div class="card">
            <h3>Data Control</h3>
            <p>Cleanup tickets (future feature)</p>
        </div>
    </div>
</div>
<%- include('footer') %>
</body>
</html>

<script>
    function confirmLogout() {
        showConfirm("Are you sure you want to logout?", function () {
            window.location.href = "/logout";
        });
    }
</script>

<% if (modalMessage) { %>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            showModal("<%= modalMessage %>");
        });
    </script>
    <% } %>