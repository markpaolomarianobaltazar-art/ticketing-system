<!DOCTYPE html>
<html>
<head>
    <title><%= dashboardTitle %> Dashboard</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<%- include('header') %>
<body>
    <div class="container">
        <% const safeUrl = typeof currentUrl !== 'undefined' ? currentUrl : '/technician'; %>
        <div class="header">
            <div class="brand-section">
                <h2>
                    <span class="brand-highlight">M&B</span> IT Solutions
                </h2>
                <p class="company-tagline">
                    <%= dashboardTitle %> • Welcome, 
                    <strong><%= user.name %></strong>
                </p>
            </div>
            <div class="header-actions">
                <a href="<%= backUrl %>" class="btn">Back</a>
                <a href="#" onclick="confirmLogout()" class="btn logout-btn">Logout</a>
            </div>
            
        
        </div>
        <div class="content">
            <div class="ticket-section">
                <div class="ticket-title-group">
                    <h3><%= viewtype %></h3>
        
                    <span class="ticket-count">
                        <%= tickets.length %> Tickets
                    </span>
                </div>
            <table class="table">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            
                <% if (tickets.length === 0) { %>
                    <tr>
                        <td colspan="5">No tickets found</td>
                    </tr>
                <% } else { %>
                    <% tickets.forEach(ticket => { %>
                        <tr>
                            <td><%= ticket.ticket_id %></td>
                            <td><%= ticket.title %></td>
                            <td>
                                <span class="priority <%= ticket.priority.trim().toLowerCase() %>">
                                    <%= ticket.priority %>
                                </span>
                            </td>
                            <td>
                                <span class="status-badge status-<%= ticket.status %>">
                                    <%= ticket.status %>
                                </span>
                            </td>
                            <td>
                                <%= new Date(ticket.created_at).toLocaleString('en-PH', {
                                    month: 'short',
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %>
                            </td>
                            <td>
                                <a href="/tickets/view/<%= ticket.ticket_id %>?backUrl=<%= safeUrl %>" class="btn">
                                    View
                                </a>
                            </td>
        
                        </tr>
                    <% }) %>
                <% } %>
            </table>
        </div>
        </div>
    </div>
    <%- include('footer') %>
</body>

<script>
    function confirmLogout() {
        showConfirm("Are you sure you want to logout?", function () {
            window.location.href = "/logout";
        });
    }
</script>