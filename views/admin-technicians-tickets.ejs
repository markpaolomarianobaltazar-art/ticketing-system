<!DOCTYPE html>
<html>
<head>
    <title>A: Technician <%= dashtitle %></title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<%- include('header') %>
<body>
    <div class="header">
        <div class="brand-section">
            <h2>
                <span class="brand-highlight">M&B</span> IT Solutions
            </h2>
        
            <p class="company-tagline">
                <%= dashtitle %> • Welcome, 
                <strong><%= user.name %></strong>
            </p>
        </div>
        <div class="header-actions">
            <a href="<%= backUrl %>" class="btn">Back</a>
            <a href="#" onclick="confirmLogout()" class="btn logout-btn">
                Logout
            </a>
        </div>
    </div>
<div class="tech-details">
    <h1><%= dashtitle %></h1>
    <hr>
    <h2>Technician Information</h2>
    <div class="tech-info">
        <p><strong>ID:</strong> <%= tech.user_id %></p>
        <p><strong>Name:</strong> <%= tech.full_name %></p>
        <p><strong>Email:</strong> <%= tech.email %></p>
        <p><strong>Position:</strong> <%= tech.position || 'N/A' %></p>
    </div>
    <hr>
    <h2>Statistics</h2>
    <div class="tech-stats">
        <div class="stat-card">
            <span>Open Tickets</span>
            <h3><%= stats.openTickets || 0 %></h3>
        </div>
        <div class="stat-card">
            <span>Closed Tickets</span>
            <h3><%= stats.closedTickets || 0 %></h3>
        </div>
        <div class="stat-card">
            <span>Total Tickets</span>
            <h3><%= stats.totalTickets || 0 %></h3>
        </div>
    </div>
    <hr>
    <h2>Assigned Tickets</h2>
    <p>Tickets Found: <%= tickets.length %></p>
    <div class="ticket-table-container">
        <table class="ticket-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% tickets.forEach(ticket => { %>
                    <tr>
                        <td>#<%= ticket.ticket_id %></td>
                        <td><%= ticket.subject %></td>
                        <td><%= ticket.status %></td>
                        <td>
                            <a href="/tickets/view/<%= ticket.ticket_id %>?backUrl=<%= encodeURIComponent(currentUrl) %>"
                                class="view-btn">
                                 View Ticket
                             </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <hr>
</div>
    <%- include('footer') %>
</body>
</html>